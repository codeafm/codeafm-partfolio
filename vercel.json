{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/privacy", "destination": "/bottle-sort/privacy", "permanent": true },
    { "source": "/support", "destination": "/bottle-sort/support", "permanent": true }
  ]
}
